# Cadena de MongoDB Atlas. Si la contraseña tiene caracteres especiales, hay que
# codificarlos en la URL (por ejemplo @ se escribe %40).
MONGODB_URI=

# Nombre de la base. Si lo dejas vacío, se usa el de la URI y, si no trae ninguno, "lol".
MONGODB_DB=lol

# Opcional. Si tiene valor, PATCH y PUT tienen que enviar la cabecera x-api-key.
# Si lo dejas vacío, cualquiera que conozca la URL puede modificar oro, jugadores, campeones e ítems.
API_WRITE_KEY=

# Opcional (recomendado en Render). Sincronización en vivo vía Ably.
# Key de ably.com → tu app → API Keys, con permisos Publish y Subscribe.
# Solo la usa el servidor; el navegador recibe tokens cortos de /api/live-token.
# Si lo dejas vacío, se usa el WebSocket local (/ws), que solo funciona si el navegador
# conecta directamente a esta API (en local con el proxy de Vite).
ABLY_API_KEY=

# Opcional. Canal de Ably (por defecto lol-dnd).
ABLY_CHANNEL=

# Opcional. Orígenes permitidos por CORS, separados por comas, sin barra final.
# Ejemplo: https://lol-dnd.vercel.app,http://localhost:5173
# Vacío = se acepta cualquier origen.
CORS_ORIGIN=

# Opcional. Puerto. Render lo pone solo; en local por defecto 3001.
# PORT=3001

# Opcional. LIVE_WS=0 desactiva el WebSocket local aunque no haya Ably.
# LIVE_WS=