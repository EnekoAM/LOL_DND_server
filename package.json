{
  "name": "lol-dnd-server",
  "version": "1.0.0",
  "private": true,
  "description": "API de LOL_DND (Express + MongoDB + Ably/WebSocket)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "set NODE_OPTIONS=--use-system-ca&& tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/seed.ts",
    "migrate:sheets": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-sheets.ts",
    "migrate:roles": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-roles.ts",
    "migrate:loot": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-loot-rules.ts",
    "migrate:ranks": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-ability-ranks.ts",
    "migrate:skills": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-skills.ts",
    "migrate:boots": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-boots-quest.ts",
    "migrate:stat-names": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-stat-names.ts"
  },
  "dependencies": {
    "ably": "^2.30.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "mongodb": "^7.7.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.2.0"
  }
}
